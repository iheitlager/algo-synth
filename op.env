# The assist server's keys (ADR-0028, #386): 1Password references only, no
# values. `op run --env-file=op.env -- …` fills them in for one process;
# `make env-check` says which resolve. A provider whose key is missing is not
# offered. Edit the vault or item to match your 1Password.
ANTHROPIC_API_KEY=op://Labs/algo-synth/Anthropic
MISTRAL_API_KEY=op://Labs/algo-synth/Mistral
GEMINI_API_KEY=op://Labs/algo-synth/Gemini
OPENROUTER_API_KEY=op://Labs/algo-synth/OpenRouter
