# Caddy serves .wasm as application/wasm, which compileStreaming requires.
:80 {
	root * /usr/share/caddy
	encode zstd gzip
	# The worklet, the deck worker and the engine must be refetched after a rebuild (ADR-0006).
	@engine path /worklet.js /deck-worker.js /dsp.wasm
	header @engine Cache-Control "no-cache"
	# Cross-origin isolated, so decks can share SharedArrayBuffer rings (ADR-0029).
	header Cross-Origin-Opener-Policy "same-origin"
	header Cross-Origin-Embedder-Policy "require-corp"
	# The assist server (ADR-0028) on the containers' network; events stream
	# unbuffered. Without it /api answers 502 and the Assistant hides.
	reverse_proxy /api/* assist:6342 {
		flush_interval -1
	}
	file_server
}
