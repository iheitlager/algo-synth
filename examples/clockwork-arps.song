# Clockwork Arps: arpeggiated techno in F minor, mostly written by the engine.
# One seeded progression, prog(8,11), feeds a Jupiter-8 pad, a Modular sub
# (its roots), and four arps: a wide Modular glass arp, a Juno pluck echoing in
# ping-pong, an FM sparkle that rolls new notes every bar and an SH-101 line
# chained by markov from a riff. A 909 keeps time, an 808 plays percussion in
# polymeter; one-bar fills, a breakbeat and a four-bar snare roll break it up
# between the scenes. The synths are spread wide by Splay, Pan2, chorus and
# pans.
tempo 128
swing 55
scale f minor

# A detuned pulse of random width on each side, through the MS-20's filter,
# opened by the envelope.
setting glass = Modular ModularBasic
  SynthDef(\glass, { |freq = 440, cutoff = 1200, gate = 1|
      var env = EnvGen.kr(Env.perc(0.002, 0.3), gate);
      var sig = { Pulse.ar(freq * Rand(0.99, 1.01), Rand(0.2, 0.5)) }.dup(2);
      RLPF.ar(sig, cutoff * (env * 3 + 1), 0.3, voicing: \ms20) * env * 0.5
  }).add;

# A phase-modulated bell, its index random per note, thrown left or right.
setting spark = Modular ModularBasic
  SynthDef(\spark, { |freq = 880, gate = 1|
      var env = EnvGen.kr(Env.perc(0.001, 0.22), gate);
      var sig = PMOsc.ar(freq, freq * 2, Rand(0.5, 3) * env);
      Pan2.ar(sig * env * 0.8, Rand(-0.9, 0.9))
  }).add;

# A sine with a little saw on top, short and warm: the off-beat roll.
setting sub = Modular ModularBasic
  SynthDef(\sub, { |freq = 55, gate = 1|
      var sig = SinOsc.ar(freq) + (Saw.ar(freq) * 0.15);
      (sig * 1.6).tanh * EnvGen.kr(Env.perc(0.003, 0.24), gate) * 0.7
  }).add;

# Four saws through the Prophet-5's ladder, spread wide, a slow vibrato.
setting swarm = Modular ModularBasic
  SynthDef(\swarm, { |freq = 440, gate = 1|
      var vib = SinOsc.kr(5).range(0.997, 1.003);
      var sig = Splay.ar({ Saw.ar(freq * vib * Rand(0.99, 1.01)) }.dup(4));
      sig = MoogFF.ar(sig, 2400, 1.5, voicing: \prophet5, drive: 0.4);
      sig * EnvGen.kr(Env.adsr(0.02, 0.4, 0.6, 0.6), gate) * 0.3
  }).add;

# Dust: a sine blip with a quick pitch drop, thrown anywhere across the field.
setting dust = Modular ModularBasic
  SynthDef(\dust, { |freq = 1200, gate = 1|
      var f = freq * Env([7, 0], [0.02], [\lin]).kr.midiratio;
      var env = EnvGen.kr(Env.perc(0.001, 0.08), gate);
      Pan2.ar(SinOsc.ar(f) * env, Rand(-0.9, 0.9))
  }).add;

track k9 drums Tr909 Kit909
track k8 drums Tr808 Kit808
track pad synth Jupiter8 JupiterPad
track low synth sub
track glass synth glass
track pluck synth Juno106 JunoPluck
track spark synth spark
track seq synth Sh101 SubPluck
track lead synth swarm
track dust synth dust

strip k9: Level 1
strip k8: Level 0.55, Pan 0.15, Send2 0.1
strip pad: Level 0.18, Send1 0.2, Send2 0.35, Send3 0.9
strip low: Level 0.6
strip glass: Level 0.4, Send1 0.25, Send3 0.4
strip pluck: Level 0.45, Send1 0.45, Send3 0.3
strip spark: Level 0.3, Send1 0.3, Send2 0.3
strip seq: Level 0.2, Pan -0.2, I1Type Overdrive, I1A 0.3, Send1 0.2
strip lead: Level 0.4, Send2 0.35, Send3 0.3
strip dust: Level 0.35, Send1 0.4
master: MasterGain 0.8, P1Return 0.35, P1A 0.6, P1B 0.5, P1D 1, P2Return 0.3, P2A 0.85, P2C 0.3, P3Type Chorus, P3Return 0.65, P3A 0.25, P3B 0.7, P3D 1, P3E 0.6

# 909: the clock.
clip kick = k9 /16
  bd x...x...x...x...
clip hats = k9 /16
  ch x.xx x.xx x.xx x.xX
  oh ..x...x...x...x.
clip clap = k9 /16
  cp ....x.......x...
clip ride = k9 /16
  rd x.x.x.x.x.x.x.x.
clip roll = k9 /16
  sn x...x...x...x...x.x.x.x.x.x.x.x.xxxxxxxxxxxxxxxxXXXXXXXXXXXXXXXX
  bd x...x...x...x...x...x...x...x...x...x...x...x...................
clip crash = k9 /16
  cr x...............................................................
# Fills and breaks, a bar at a time between the scenes.
clip fill = k9 /16
  bd x.....x.........
  sn ........xxXXxXXX
  oh x...............
  cp ............x.x.
clip breakbeat = k9 /16
  bd x.....x...x..x..
  sn ....X..x.x..X..x
  ch xxXxxxXxxxXxxxXx
  oh ..............x.

# 808: percussion in polymeter, each lane its own length.
clip poly = k8 /16
  cl euclid(5,16,2)
  rs euclid(3,7)
  ma x.x.x
  hc euclid(4,11,1)
  lc euclid(3,13,4)
clip cow = k8 /16
  cb euclid(3,16,5)
clip toms = k8 /16
  lt x.....x.....
  mt ...x.....x
  ht .....x.....x.x
clip tomfill = k8 /16
  ht x.x.............
  mt ....x.x.........
  lt ........x.x.xXX.
clip tomroll = k8 /16
  ht ................................................xx..xx..........
  mt ....................................................xx..xx......
  lt ........................................................xxxxXXXX

# The progression and everything it feeds.
clip chords = pad voicing
  prog(8,11)
clip roots = low .struct("~ x x x ~ x x x ~ x x x ~ x x x")
  root(chords,1)
clip glassy = glass .every(4, rev)
  arp(chords,updown,16)
clip plucks = pluck .off(3/16, add(12)) .degrade(0.15)
  arp(chords,up,8)
clip sparks = spark live
  arp([f5,g#5,c6,d#6,g6],random,16,13)

# The SH-101: a riff, then a markov chain of it, new every bar.
clip riff = seq
  "f2 f3 c3 f2 g#2 f3 c3 d#3 f2 f3 c3 f2 a#2 c3 d#3 g2"
clip chain = seq live
  markov(2,riff,7)
clip bent = seq .palindrome()
  mutate(riff,40,9)

# The lead: a theme, and a walk on the scale for the peak.
clip theme = lead
  c5:2 g#4:4 a#4:4 c5:4. d#5:8 c5:4 g#4:4
clip wander = lead live
  walk(c5,8,21)

clip specks = dust .iter(4)
  euclid(7,16,2) scale f5

auto seq_shut = seq.Cutoff 500 /8
auto seq_open = seq.Cutoff ramp 500 3000 /16
auto seq_peak = seq.Cutoff 1500 3200 2000 3600 /4
auto seq_res = seq.Resonance 0.6 /8
auto seq_build = seq.Resonance ramp 0.6 0.9 /4
auto rise = master.P1Return ramp 0.35 0.65 /4

mod pad.cutoff = lfo([0.11, 0.17, 0.23, 0.29]).exprange(700, 3200)
mod glass.ctl1 = perlin.slow(4).exprange(700, 3500)
mod pluck.pan = sine.slow(4).range(-0.7, 0.7)
mod lead.pan = sine.slow(8).range(-0.4, 0.4)

snapshot dry: master.P1Return 0.35, master.P2Return 0.3
snapshot wet: master.P1Return 0.55, master.P2Return 0.55

scene intro 7: kick poly chords [dry]
scene intro_fill 1: kick tomfill chords
scene arps 15: kick hats poly roots chords glassy plucks
scene arps_fill 1: fill tomfill roots chords glassy plucks
scene chain 12: kick hats clap poly cow roots glassy chain specks seq_open seq_res
scene chain_break 4: breakbeat poly cow roots glassy chain specks seq_res
scene break 8: chords sparks glassy specks [wet]
scene build 4: roll tomroll bent plucks seq_shut seq_build rise
scene peak 7: crash kick hats clap ride poly roots glassy plucks chain theme seq_peak seq_res [dry]
scene peak_fill 1: fill tomfill ride roots glassy plucks chain theme seq_peak seq_res
scene climb 6: crash kick hats clap ride poly cow toms roots glassy sparks bent wander specks seq_peak seq_build
scene climb_break 1: breakbeat cow roots glassy sparks bent wander specks
scene climb_fill 1: fill tomfill sparks wander specks
scene outro 8: kick poly chords plucks
arrange intro intro_fill arps arps_fill chain chain_break break build peak peak_fill peak peak_fill climb climb_break climb_fill climb climb_break climb_fill outro
loop 53 84
