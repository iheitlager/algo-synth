# Deep Polyrhythm: deep house in A minor, Am9 Dm9 Fmaj7 Em7, layered in
# polyrhythm over a straight 909. Four against the kick, three in the Rhodes
# triplets and the Juno stabs' 3-3-3-3-2-2, five in a Modular kalimba, seven
# in a Modular tick; under it the 808's percussion loops at 3, 7, 10 and 12
# steps, so it never lines up the same way twice in a phrase. An SH-101 plays
# the chords' roots, a Jupiter-8 pad holds them. Two arps weave through: a
# Modular glint up and down the ninth chords with a fifth echoing a dotted
# eighth behind, and a Prophet-5 bell in sixteenth triplets. Ghost notes sit
# under the groove; breaks with flams, drags and a triplet fill turn the
# phrases.
tempo 122
swing 58
scale a minor

# A sine with a short phase-modulated strike: a kalimba, placed a little apart.
setting kalimba = Modular ModularBasic
  SynthDef(\kalimba, { |freq = 440, gate = 1|
      var env = EnvGen.kr(Env.perc(0.001, 0.6), gate);
      var strike = PMOsc.ar(freq * 3, freq * 4.1, 2) * Env.perc(0.001, 0.08).kr * 0.2;
      Pan2.ar((SinOsc.ar(freq) + strike) * env * 0.6, Rand(-0.5, 0.5))
  }).add;

# Two detuned saws, one each side, plucked through the Juno-106's ladder.
setting glint = Modular ModularBasic
  SynthDef(\glint, { |freq = 440, cutoff = 1400, gate = 1|
      var env = EnvGen.kr(Env.perc(0.002, 0.28), gate);
      var sig = { Saw.ar(freq * Rand(0.995, 1.005)) }.dup(2);
      MoogFF.ar(sig, cutoff * (env * 4 + 1), 1.8, voicing: \juno106, drive: 0.2) * env * 0.4
  }).add;

# A click of high-passed noise, swaying slowly from side to side.
setting tick = Modular ModularBasic
  SynthDef(\tick, { |freq = 4000, gate = 1|
      var env = EnvGen.kr(Env.perc(0.001, 0.035), gate);
      Pan2.ar(RHPF.ar(WhiteNoise.ar, 6500, 0.3) * env * 2, SinOsc.kr(0.25) * 0.7)
  }).add;

track kit drums Tr909 Kit909
track perc drums Tr808 Kit808
track bass synth Sh101 Sh101Bass
track pad synth Jupiter8 JupiterPad
track stab synth Juno106 JunoPoly
track keys synth Dx7 FmElectricPiano
track kalimba synth kalimba
track tick synth tick
track glint synth glint
track bells synth Prophet5 P5Bell

strip kit: Level 1
strip perc: Level 0.5, Pan -0.1, Send2 0.15
strip bass: Level 0.5
strip pad: Level 0.2, Send2 0.4, Send3 0.6
strip stab: Level 0.4, Pan 0.15, Send1 0.45, Send3 0.3
strip keys: Level 0.2, Pan -0.15, Send2 0.3, Send3 0.3
strip kalimba: Level 0.4, Send1 0.35, Send2 0.2
strip tick: Level 0.5, Send1 0.2
strip glint: Level 0.45, Pan 0.25, Send1 0.4, Send3 0.3
strip bells: Level 0.18, Pan -0.25, Send1 0.3, Send2 0.35
master: MasterGain 0.8, P1Return 0.35, P1A 0.55, P1B 0.45, P1D 1, P2Return 0.3, P2A 0.8, P3Type Chorus, P3Return 0.5, P3A 0.2, P3B 0.6, P3D 1, P3E 0.5

# 909: four on the floor.
frag kick = kit /16
  bd x...x...x...x...
frag hats = kit /16
  ch x.xx x.xx x.xx x.xX
  oh ..x...x...x...x.
frag clap = kit /16
  cp ....x.......x...
  rs ......x.......x.
frag ride = kit /16
  rd x.x.x.x.x.x.x.x.
frag lift = kit /16
  sn ........x.x.xxXX
  oh x...............
# Ghost notes under the groove: a soft snare between the claps, a rim answering.
frag ghosts = kit /16
  sn ..o..o.o..o.o..o
  rs .o.....o.o......

# Breaks, a bar each, where a phrase turns.
frag brk = kit /16
  bd x.....x...x..x..
  sn ....f..o.o..X.od
  ch x.xox.xox.x.....
  oh ..............x.
frag tripfill = kit /24
  bd x.....x.....x...........
  sn ..o..f..o..f.oo.f.f.ffXX
  oh x.......................
frag rollout = kit /32
  sn o.o.o.o.o.o.o.o.x.x.x.x.d.d.xxXX
  bd x...............x...............

# 808: polymeter, each lane its own length.
frag shaker = perc /16
  ma X.x
frag congas = perc /16
  lc euclid(5,12,1)
  hc euclid(4,10,3)
  cl x......
frag bell = perc /16
  cb euclid(3,16,10)

# The progression: one chord a bar, voiced close.
frag chords = pad voicing
  "<a2:m9 d3:m9 f2:maj7 e2:m7>"
# Three against four: the Rhodes on the second and third thirds of each bar.
frag rhodes = keys voicing
  "<[~ a3:m9 a3:m9] [~ d3:m9 d3:m9] [~ f3:maj7 f3:maj7] [~ e3:m7 e3:m7]>"
# The Juno's stabs in 3-3-3-3-2-2, the dotted pulse that pulls against the kick.
frag stabs = stab voicing .struct("x ~ ~ x ~ ~ x ~ ~ x ~ ~ x ~ x ~")
  "<a3:m7 d3:m7 f3:maj7 e3:m7>"

# The roots, low and syncopated.
frag low = bass .struct("x ~ ~ x ~ ~ x ~ ~ ~ x ~ x ~ ~ ~")
  root(chords,1)

# Five against four: five even notes a bar, walking with the chords.
frag five = kalimba .every(4, rev)
  "<[e5 c5 a4 g4 a4] [f5 d5 a4 c5 a4] [e5 c5 a4 f4 a4] [g5 e5 b4 g4 e4]>"
# The glint: up and down the ninth chords, a fifth up echoing a dotted eighth
# behind, and every third bar backwards.
frag glimmer = glint .off(3/16, add(7)) .every(3, rev)
  arp(chords,updown,16)
# The bells: down the progression, each note three times in sixteenth
# triplets against the four, a quarter of them left out, each bar a step on.
frag cascade = bells .ply(3) .degrade(0.25) .iter(4) .add(12)
  arp(chords,down,8)
# Seven against four.
frag seven = tick
  "c6*7"

auto bass_low = bass.Cutoff 500 /8
auto bass_open = bass.Cutoff ramp 500 1400 /16
auto bass_res = bass.Resonance 0.35 /8
auto stab_open = stab.Cutoff ramp 600 3200 /8
auto stab_dark = stab.Cutoff 900 /8
auto pad_rise = pad.Cutoff ramp 500 2600 /8
auto glint_open = glint.Ctl1 ramp 700 2800 /16
mod pad.resonance = lfo([0.1, 0.13, 0.17, 0.21]).range(0.1, 0.4)
mod tick.pan = sine.slow(2).range(-0.6, 0.6)

scene dry: master.P1Return 0.35, master.P2Return 0.3
scene wet: master.P1Return 0.55, master.P2Return 0.55

section intro 7: kick hats shaker chords pad_rise [dry]
section intro_brk 1: brk shaker chords
section groove 15: kick hats clap ghosts shaker congas chords low stabs bass_low bass_res stab_dark
section groove_lift 1: tripfill shaker congas chords low stabs
section keys 15: kick hats clap ghosts shaker congas chords low rhodes five glimmer bass_open bass_res glint_open
section keys_brk 1: brk shaker congas chords low rhodes five glimmer
section break 8: chords rhodes five seven cascade glimmer shaker [wet]
section main 15: kick hats clap ghosts ride shaker congas bell chords low stabs rhodes five seven glimmer cascade bass_open bass_res stab_open [dry]
section main_roll 1: rollout shaker congas chords low stabs rhodes five seven
section deep 7: kick hats clap ghosts shaker congas bell chords low rhodes five cascade bass_low bass_res stab_dark
section deep_brk 1: tripfill shaker congas chords low rhodes five cascade
section deep2 7: kick hats clap ghosts shaker congas bell chords low rhodes five glimmer cascade bass_low bass_res stab_dark
section deep_turn 1: brk shaker congas chords low rhodes five glimmer
section outro 8: kick hats shaker chords five
arrange intro intro_brk groove groove_lift keys keys_brk break main main_roll deep deep_brk deep2 deep_turn outro
loop 49 80
