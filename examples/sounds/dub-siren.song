# Dub Siren: the sounds of siren-system.song from one box, the ModularDubSiren
# preset, each a setting of its panel over a steppers dub at 76, every siren
# thrown into the dotted-eighth echo (P1) on Send1.
# The panel: Ctl1 mode (0 square, 1 triangle, 2 saw up, 3 saw down, 4 random
# step, 5 random smooth), Ctl2 amount (the base in semitones from the key), Ctl3
# rate (Hz), Ctl4 depth (the swing above the base, semitones), Ctl5 sweep (the
# glide time when let go, s), Ctl6 dir (that glide 0 down, 1 up).
tempo 76
swing 50
scale g minor

# the four of the real thing: base at the key, a dive on release
setting whoop = Modular ModularDubSiren: Ctl1 2, Ctl2 0, Ctl3 5, Ctl4 12, Ctl5 1.2, Ctl6 0
setting laser = Modular ModularDubSiren: Ctl1 3, Ctl2 0, Ctl3 9, Ctl4 19, Ctl5 1.2, Ctl6 0
setting trill = Modular ModularDubSiren: Ctl1 0, Ctl2 0, Ctl3 7, Ctl4 7, Ctl5 1.2, Ctl6 0
setting wailer = Modular ModularDubSiren: Ctl1 1, Ctl2 0, Ctl3 0.7, Ctl4 12, Ctl5 1.2, Ctl6 0
# the effects: an octave either side of the key, a short tail, some rising
setting updown = Modular ModularDubSiren: Ctl1 2, Ctl2 -12, Ctl3 2, Ctl4 24, Ctl5 0.4, Ctl6 1
setting wail = Modular ModularDubSiren: Ctl1 1, Ctl2 -12, Ctl3 0.5, Ctl4 24, Ctl5 0.4, Ctl6 0
setting twotone = Modular ModularDubSiren: Ctl1 0, Ctl2 0, Ctl3 1.2, Ctl4 5, Ctl5 0.3, Ctl6 0
setting zap = Modular ModularDubSiren: Ctl1 0, Ctl2 12, Ctl3 0, Ctl4 0, Ctl5 0.6, Ctl6 0
setting bubble = Modular ModularDubSiren: Ctl1 3, Ctl2 0, Ctl3 9, Ctl4 24, Ctl5 0.3, Ctl6 1
setting robot = Modular ModularDubSiren: Ctl1 4, Ctl2 -12, Ctl3 8, Ctl4 31, Ctl5 0.3, Ctl6 0
setting drift = Modular ModularDubSiren: Ctl1 5, Ctl2 -5, Ctl3 3, Ctl4 12, Ctl5 2, Ctl6 1

track drums drums Tr808 Kit808
track bass synth Sh101 Sh101Bass
track whoop synth whoop
track laser synth laser
track trill synth trill
track wailer synth wailer
track updown synth updown
track wail synth wail
track twotone synth twotone
track zap synth zap
track bubble synth bubble
track robot synth robot
track drift synth drift

strip drums: Level 0.9, Send1 0.1
strip bass: Level 0.85
strip whoop: Level 0.45, Pan -0.4, Send1 0.6, Send2 0.2
strip laser: Level 0.4, Pan 0.4, Send1 0.6, Send2 0.15
strip trill: Level 0.4, Pan -0.1, Send1 0.5, Send2 0.2
strip wailer: Level 0.4, Pan 0.1, Send1 0.5, Send2 0.25
strip updown: Level 0.45, Pan -0.3, Send1 0.5, Send2 0.2
strip wail: Level 0.4, Pan 0.3, Send1 0.5, Send2 0.2
strip twotone: Level 0.4, Pan -0.5, Send1 0.45, Send2 0.2
strip zap: Level 0.45, Pan 0.5, Send1 0.6, Send2 0.1
strip bubble: Level 0.4, Pan 0.2, Send1 0.55, Send2 0.15
strip robot: Level 0.4, Pan 0.4, Send1 0.5, Send2 0.2
strip drift: Level 0.4, Pan -0.2, Send1 0.5, Send2 0.3
# P1 echo: a dotted eighth at 76, long feedback, dark repeats, ping-pong
master: MasterGain 0.8, P1Return 0.6, P1A 0.84, P1B 0.7, P1C 0.3, P1D 1, P2Return 0.3

# one-drop: kick and rim together on 3, hats on the eighths
clip drop = drums /16
  bd ........x.......
  rs ........x.......
  ch x.x.x.x.x.x.x.xX
# steppers: four on the floor for the peak
clip steppers = drums /16
  bd x...x...x...x...
  sn ........x.......
  ch x.x.x.x.x.x.x.x.
  oh ..x...x...x...x.
# dub drums: only the kick and a snare thrown into the echo
clip dub_drums = drums /16 .send1("~ ~ ~ ~ ~ ~ ~ ~ 1 ~ ~ ~ ~ ~ ~ ~")
  bd ........x.......
  sn ........x.......

# the bassline, two bars
clip line = bass
  g1:4. g1:8 r:8 a#1:8 c2:4 d2:4. r:8 f1:8 g1:8 r:4 a#1:8 a1:8
clip line_drop = bass
  g1:4. g1:8 r:2 r:1

# the sirens: press, hold, let go and hear it glide into the echo
clip whoops = whoop
  g4:4. r:8 r:2 g4:4. r:8 r:2
clip lasers = laser
  r:2 d5:8 r:8 d5:8 r:8 r:2 g5:8 r:8 r:4
clip trills = trill
  r:1 a#4:2 r:2
clip wails_long = wailer
  g3:1 r:1
clip up_down = updown
  g4:1 r:1
clip air_raid = wail
  d4:1 d4:1
clip nee_naw = twotone
  r:2 g4:2 r:1
clip zaps = zap
  r:4 g4:8 r:8 r:4 d4:8 r:8 r:4 g4:8 r:8 a#4:4
clip bubbles = bubble
  r:2 d4:4 r:4 r:2 g4:4 r:4
clip robots = robot
  r:1 g4:1
clip drifting = drift
  d4:2. r:4 r:1

scene intro 4: drop up_down
scene riddim 8: drop line zaps
scene sirens 8: drop line air_raid nee_naw bubbles
scene dub 8: dub_drums line_drop up_down drifting zaps
scene peak 8: steppers line air_raid zaps robots
scene soundclash 8: drop line whoops lasers trills
scene dub2 8: dub_drums line_drop whoops wails_long lasers
scene outro 4: drop drifting
arrange intro riddim sirens dub peak soundclash dub2 outro
