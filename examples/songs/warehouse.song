# Warehouse: Chicago acid house in F minor, an 808 and three TB-303s (#536),
# no Modular. A square 303 holds the bass, a saw 303 jacks the acid line,
# and the squelch 303 answers high up through the echo. The acid line's
# decay and accent rise through the track, so the same notes grow from a
# burble into a shriek; the break leaves the line alone with its cutoff.
tempo 122
swing 56
scale f minor

track kit drums Tr808 Kit808
track bass synth Tb303 Tb303Square
track acid synth Tb303 Tb303Acid
track high synth Tb303 Tb303Squelch

strip kit: Level 0.7
strip bass: Level 1
strip acid: Level 0.75, Pan -0.1, I1Type Overdrive, I1A 0.35, Send1 0.12
strip high: Level 0.4, Pan 0.3, Send1 0.45
master: P1Return 0.35, P1B 0.55

clip jack = kit /16
  bd x...x...x...x...
  ch ..x...x...x...x.
clip house = kit /16
  bd x...x...x...x...
  cp ....x.......x...
  ch ..x...x...x...x.
  oh x.x.x.x.x.x.x.x.
clip cow = kit /16
  cb ...x.....x.....x
clip roll = kit /16
  lt ............................................................x.x.
  ht ..............................................................xx
  cp ................................................x.x.x.x.x.x.xxxx

# The bass: root and octave, the fifth to turn the bar.
clip root = bass
  "<[f1 ~ f2 ~ f1 ~ f2 f1] [f1 ~ f2 ~ c2 ~ eb2 c2]>"
# The acid line: a two-bar jack of one F with the minor third and the
# seventh, accents off the beat, slides into the octave.
clip line = acid
  "<[f1! f1 f2& f1 ~ f1! ab1 f1& c2 f1 ~ f2! eb2& f1 c2!& f1] [f1 ~ f1! ab1 f1 c2& bb1 f1! ~ f1 f2& eb2 c2 ab1! f1 ~]>"
# Half the notes, so the decay has room to ring.
clip sparse = acid
  "f1! ~ ~ f1 ~ ~ f2!& f1 ~ ~ ab1! ~ c2& ~ f1 ~"
# The squelch's answer, every other bar.
clip answer = high
  "<[~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~] [~ ~ f3! ~ ~ c3& eb3 ~ ~ ~ f3! ~ ab3& f3 ~ ~]>"

auto acid_shut = acid.Cutoff ramp 400 900 /8
auto acid_open = acid.Cutoff ramp 700 2600 /16
auto acid_wide = acid.Cutoff 2200 1100 2800 1500 /4
auto acid_break = acid.Cutoff ramp 300 3400 /8
auto acid_res = acid.Resonance ramp 0.6 0.9 /16
auto acid_top = acid.Resonance 0.92 /8
auto decay_burble = acid.FenvDecay 0.15 /8
auto decay_grow = acid.FenvDecay ramp 0.15 0.8 /16
auto decay_long = acid.FenvDecay 1.0 /8
auto accent_grow = acid.Accent ramp 0.3 0.9 /16
auto accent_full = acid.Accent 0.95 /8

scene intro 8: jack root
scene jack 16: house root line acid_shut acid_res decay_burble
scene grow 16: house cow root line roll acid_open acid_res decay_grow accent_grow
scene break 8: cow sparse acid_break acid_top decay_long accent_full
scene peak 16: house cow root line answer roll acid_wide acid_top decay_long accent_full
scene outro 8: jack root sparse acid_shut acid_res decay_burble
arrange intro jack grow break peak outro
