# NES Fortress (#112): an original tune in the style of the fast NES action
# scores of the late 80s, on the Nes model alone.
#
# 150 BPM is six frames a sixteenth at the NTSC console's 60 Hz. The lead is
# a 25 % pulse with a quieter 50 % pulse a few cents off under it and a late
# vibrato; the chords are a thin 12.5 % pulse the driver arpeggiates every
# frame; the bass is the triangle, octaves in eighths; the drums are played
# from lanes by NesKit, as NES scores mixed them: a sampled kick and snare
# from the Audiophob kit through the DMC, 1-bit deltas at 33 kHz, beside the
# chip's own noise hats and triangle toms.
tempo 150

setting lead = Nes NesLead: NesVibrato 0.15, NesVibratoDelay 12
setting arp_min = Nes NesArp: Polyphony 1, NesArp 2, NesP1Duty 0, NesP1Volume 10, NesP1Decay 0
setting arp_maj = Nes NesArp: Polyphony 1, NesArp 1, NesP1Duty 0, NesP1Volume 10, NesP1Decay 0
setting bass = Nes NesBass

track lead synth lead
track arp_min synth arp_min
track arp_maj synth arp_maj
track bass synth bass
track kit drums Nes NesKit
pad kit 1 = audiophob/01-Kick
pad kit 3 = audiophob/05-Snare_Rock

strip lead: Level 0.7, Send1 0.15
strip arp_min: Level 0.6, Pan -0.3
strip arp_maj: Level 0.6, Pan -0.3
strip bass: Level 0.9
strip kit: Level 0.8, Pan 0.15
master: MasterGain 0.8, P1Return 0.2, P1A 0.5, P1B 0.25

# E minor: Em C D B.
clip bass_a = bass
  "<[e2 e3 e2 e3 e2 e3 e2 e3] [c2 c3 c2 c3 c2 c3 c2 c3] [d2 d3 d2 d3 d2 d3 d2 d3] [b1 b2 b1 b2 b1 b2 d#2 f#2]>"

clip chords_min = arp_min
  "<e4 ~ ~ ~>"
clip chords_maj = arp_maj
  "<~ c4 d4 b3>"

clip lead_a = lead
  e5:8 g5:8 b5:8 a5:16 g5:16 f#5:8 g5:8 e5:4 e5:8 g5:16 e5:16 c5:8 e5:8 g5:4 a5:8 g5:8 f#5:8 a5:8 d6:8 c6:16 b5:16 a5:8 f#5:8 d5:4 d#5:4. f#5:8 b5:4 a5:8 f#5:8
clip lead_b = lead
  b4:8 e5:8 g5:8 b5:8 c6:8 b5:8 g5:4 c6:8 b5:16 a5:16 g5:8 e5:8 c5:4 e5:8 g5:8 a5:8 f#5:8 d5:8 f#5:8 a5:8 d6:8 c6:8 a5:8 b5:2 d#6:8 c#6:8 b5:8 f#5:8

clip beat = kit /16
  bd x.....x.x.......
  sn ....x.......x...
  ch x.x.x.x.x.x.x.x.
clip fill = kit /16
  bd x...............
  sn ....x...x.x.xxxx
  ht ..x.x...........
  lt ......x.x.......

scene intro 4: bass_a beat
scene verse 8: bass_a chords_min chords_maj lead_a beat
scene turn 8: bass_a chords_min chords_maj lead_b beat
scene fill 1: bass_a fill
arrange intro verse turn fill verse
