# Pocket Orchestra: the toy and chip boxes of the last releases in one band.
# One generated progression (prog, then markov for the B part) drives
# everything that plays notes. The NES, SID and Atari Punk break it into arps
# at three speeds: sixteenths, triplets and gliding eighths. The Casio MT-40
# bass walks it. Two Casio VL-1s play a theme written as chord degrees
# (.chord), the violin two chord notes under the flute, so they move in
# harmony whatever the chords are. The CR-78 plays the groove with FM drum
# layers on top. Dub sirens are thrown into the echo. The Arp 2600 and MS-20
# play no notes worth humming: only white noise through resonant filters,
# risers, swoops and swooshes into a flanger.
# Change prog's seed (11) for another song in the same style.
tempo 112
swing 54
scale d minor

# Casio MT-40 bass (sleng-teng.song): a hollow square on a sine body
setting mt40 = Modular ModularBasic
  SynthDef(\mt40, { |freq = 65, gate = 1, cutoff = 9000|
      var body = SinOsc.ar(freq) * 0.9;
      var sq = Pulse.ar(freq, 0.4961) * 0.45;
      var oct = Pulse.ar(freq * 2, 0.5039) * 0.08;
      var fenv = EnvGen.kr(Env.perc(0.001, 0.12), gate);
      var sig = LPF.ar(sq + oct, cutoff * 0.5 + (cutoff * fenv)) + body;
      sig = (sig * 1.1).tanh * EnvGen.kr(Env.adsr(0.0011, 0.2, 0.75, 0.06), gate) * 0.8;
      Pan2.ar(sig, 0)
  }).add;

# FM drum (fm-drum.song): a deep kick under the CR-78's, and toms
setting fmkick = Modular ModularFmDrum: Ctl2 1.5, Ctl3 6, Ctl4 30, Ctl5 0.05, Ctl6 0.45, Ctl7 0, Ctl8 4
setting fmtom = Modular ModularFmDrum: Ctl2 1.5, Ctl3 12, Ctl4 12, Ctl5 0.1, Ctl6 0.3, Ctl7 0, Ctl8 2

# Atari Punk (atari-punk.song): thin transistor chords, and a mono voice
# sliding between the arp's notes
setting punkpad = Modular ModularPunk: Assign 0, Ctl1 0.68, Ctl2 1, Ctl3 1, AdsrAttack 0.02, AdsrRelease 0.6
setting punkglide = Modular ModularPunk: Assign 2, Ctl1 0.45, Ctl2 1, Ctl3 0, Ctl4 0.06, AdsrRelease 0.08

# NES: a thin 12.5 % pulse, short and plucked; SID: a swept pulse
setting nes = Nes NesLead: Polyphony 1, NesP1Duty 0, NesP1Volume 11, NesP1Decay 1, NesP2On 0, NesVibrato 0
setting sid = Sid SidLead: Polyphony 1, Sid1Release 4, SidVibratoDelay 30

# the dub siren (dub-siren.song): the NJD clone
setting njd = Modular ModularDubSiren: Ctl1 0, Ctl2 0, Ctl3 3.3, Ctl4 12, Ctl5 2.5, Ctl6 0, Ctl7 1, Ctl8 600, Ctl9 1, Ctl10 1

# MS-20 noise: a jet riser, its four-second attack opening the filter four
# octaves (EnvCutoff) into the next scene; and a reverse swell into each bar
setting jet = Ms20 JetSweep: NoiseColour 0, Cutoff 250, Resonance 0.85, EnvCutoff 1, AdsrAttack 4, AdsrSustain 1, AdsrRelease 1.5, LfoRate 0.4, LfoCutoff 0.3
setting swell = Ms20 JetSweep: NoiseColour 0, HpCutoff 800, Cutoff 600, Resonance 0.6, EnvCutoff 0.9, AdsrAttack 0.5, AdsrSustain 1, AdsrRelease 0.04, LfoCutoff 0
# Arp 2600 noise: a whistling swoop the triangle LFO rolls up and down, and a
# down swoosh, the envelope closing the filter after each hit
setting swoop = Arp2600 Lead: Vco1Level 0, Vco2Level 0, Vco3Level 0, NoiseLevel 1, NoiseColour 0, Cutoff 900, Resonance 0.88, EnvCutoff 0, LfoWave 2, LfoRate 0.45, LfoCutoff 1, Vibrato 0, AdsrAttack 0.7, AdsrSustain 1, AdsrRelease 2
setting swoosh = Arp2600 Lead: Vco1Level 0, Vco2Level 0, Vco3Level 0, NoiseLevel 1, NoiseColour 0, Cutoff 350, Resonance 0.75, EnvCutoff 1, LfoCutoff 0, Vibrato 0, AdsrAttack 0.005, AdsrDecay 2, AdsrSustain 0, AdsrRelease 2

track cr78 drums PadSampler
samples cr78 roland-cr78
track fmkick synth fmkick
track fmtom synth fmtom
track bass synth mt40
track pad synth punkpad
track glide synth punkglide
track nes synth nes
track sid synth sid
track flute synth VlTone VlFlute
track violin synth VlTone VlViolin
track njd synth njd
track vlkit drums VlTone VlKit
track jet synth jet
track swell synth swell
track swoop synth swoop
track swoosh synth swoosh

# Send1 echo, Send2 reverb, Send3 chorus, Send4 flanger
strip cr78: Level 0.85, Send1 0.1, Send2 0.15
strip fmkick: Level 0.7
strip fmtom: Level 0.55, Pan -0.3, Send1 0.2, Send2 0.3
strip bass: Level 0.8, Send3 0.15
strip pad: Level 0.22, Pan -0.2, I1Type Phaser, I1A 0.2, I1B 0.7, I1C 0.5, Send2 0.5, Send3 0.7
strip glide: Level 0.4, Pan 0.3, Send1 0.45, Send2 0.3, Send4 0.4
strip nes: Level 0.5, Pan -0.45, Send1 0.35, Send2 0.3, Send3 0.4
strip sid: Level 0.4, Pan 0.45, Send1 0.3, Send2 0.35, Send3 0.5
strip flute: Level 0.6, Pan 0.1, Send1 0.3, Send2 0.4, Send3 0.3
strip violin: Level 0.45, Pan -0.15, Send1 0.25, Send2 0.45, Send3 0.6
strip njd: Level 0.5, Pan 0.2, Send1 0.7, Send2 0.3
strip vlkit: Level 0.6, Pan -0.4, Send1 0.45, Send2 0.25
strip jet: Level 0.4, Send2 0.6, Send4 0.8
strip swell: Level 0.4, Pan 0.4, Send2 0.5, Send4 0.6
strip swoop: Level 0.45, Pan -0.3, Send1 0.3, Send2 0.6, Send4 0.9
strip swoosh: Level 0.45, Pan 0.3, Send2 0.8, Send4 0.5
# P1 a ping-pong dotted eighth at 112, P2 a long dark hall, P3 a wide
# chorus, P4 a slow jet flanger with the feedback up
master: MasterGain 0.75, P1Return 0.5, EchoTime 0.402, EchoFeedback 0.6, P1C 0.45, P1D 1, P2Return 0.45, ReverbSize 4.5, ReverbCutoff 6000, P2C 0.2, P3Type Chorus, P3Return 0.6, P3A 0.25, P3B 0.7, P3C 0.4, P3D 1, P3E 0.6, P4Type Flanger, P4Return 0.5, P4A 0.08, P4B 0.85, P4C 0.4, P4D 0.8, P4E 0.6

# The harmony: eight bars of sevenths in D minor, the borrowed chords in;
# the B part a new progression chained from the same chords
clip chords = pad voicing
  prog(8,11,7th,4,borrow)
clip chords_b = pad voicing
  markov(1,chords,3)

# the bass: the MT-40 walking, then pumping octaves in the B part
clip walk = bass
  bass(chords,walk,5)
clip pump = bass
  bass(chords_b,octave)

# three arps at three speeds over the same chords
clip nes_arp = nes
  arp(chords,pinkyup:2,16)
clip nes_arp_b = nes
  arp(chords_b,up&down:2,16)
clip sid_arp = sid
  arp(chords,up:3,12)
clip sid_arp_b = sid
  arp(chords_b,converge:2,12)
clip glide_arp = glide .oct(-1)
  arp(chords,updown,8)
clip glide_arp_b = glide .oct(-1)
  arp(chords_b,random,8,9)
# the SID set loose in the climax: a new walk every bar, on the chords
clip sid_walk = sid live
  walk(d5,8,4,chords_b)

# the theme as chord degrees: the flute on top, the violin two chord notes
# under it, so the pair keeps in harmony on every chord
clip theme = flute .chord(chords) .oct(1)
  "<[4 ~ 3 2] [3 ~ ~ 4] [5 4 3 ~] [2 ~ ~ ~] [4 ~ 5 6] [5 ~ 4 ~] [3 4 3 2] [1 ~ ~ ~]>"
clip under = violin .chord(chords) .oct(1)
  "<[2 ~ 1 0] [1 ~ ~ 2] [3 2 1 ~] [0 ~ ~ ~] [2 ~ 3 4] [3 ~ 2 ~] [1 2 1 0] [-1 ~ ~ ~]>"
clip theme_b = flute .chord(chords_b) .oct(1)
  "<[4 ~ 3 2] [3 ~ ~ 4] [5 4 3 ~] [2 ~ ~ ~] [4 ~ 5 6] [5 ~ 4 ~] [3 4 3 2] [1 ~ ~ ~]>"
clip under_b = violin .chord(chords_b) .oct(1)
  "<[2 ~ 1 0] [1 ~ ~ 2] [3 2 1 ~] [0 ~ ~ ~] [2 ~ 3 4] [3 ~ 2 ~] [1 2 1 0] [-1 ~ ~ ~]>"

# CR-78: its own kick and snare, the hats on the eighths with a sixteenth
# push, the tambourine on the backbeat, guiro, congas and the woodblock
clip cr_intro = cr78 /16
  ch x.x.x.x.x.x.x.xx
  p12 ..x.......x.....
  p3 ......x.....x.x.
  p4 ...x......x.....
clip cr_beat = cr78 /16
  bd x.....x...x.....
  sn ....x.......x...
  ch x.xxx.x.x.xxx.xo
  oh ..............x.
  p7 ....x.......x...
  p12 ..x.......x.....
  p3 ......x.....x.x.
  p4 ...x......x.....
clip cr_dub = cr78 /16
  bd x.........x.....
  ch x.x.x.x.x.x.x.x.
  p9 euclid(5,16,3)
  cb euclid(5,16,2)
  p1 ......x.......x.
clip cr_peak = cr78 /16
  bd x.....x...x...x.
  sn ....x.......x..o
  ch xxxxxxxxxxxxxxxx
  oh ..x...x...x...x.
  p7 ....x.......x...
  cb euclid(3,8,2)
  p3 ......x.....x.x.
  p4 ...x......x..x..

# FM drums: the kick doubling the CR-78's on the beats, a tom run into
# every fourth bar
clip fm_kicks = fmkick
  "a1 ~ ~ ~ a1 ~ ~ ~"
clip fm_toms = fmtom
  "<~ ~ ~ [~ ~ ~ ~ [a2 a2] [e2 e2] [c2 a1] a1]>"

# the siren: the NJD pressed for a bar and let go into the echo
clip siren = njd
  d5:1 r:1 r:1 r:1


# the VL-1's rimshot (Pi), here and there: a blip on an off-beat every
# other bar, thrown into the echo in the dub, ratcheting in the climax
clip pi = vlkit /16
  rs ..........x...............x..x..
clip pi_dub = vlkit /16 .send1("~ ~ ~ ~ ~ ~ 1 ~ ~ ~ ~ ~ ~ ~ ~ ~")
  rs ......x.......x.......x...x.x...
clip pi_peak = vlkit /16
  rs ..x.......x2...x..x.......x...x3

# noise: the jet rising through the last two bars of a scene, a reverse
# swell into each other bar, the 2600's swoops and swooshes
clip rise = jet
  r:1 r:1 r:1 r:1 r:1 r:1 d4:1& d4:1
clip swells = swell
  "<~ [~ ~ ~ d4]>"
clip swoops = swoop
  "<d5 ~ ~ ~ a4 ~ ~ ~>"
clip swooshes = swoosh
  "<d4 ~ ~ ~>"

# the dub break's echo feeds back further and further; the flanger sweeps
auto feed = master.P1B ramp 0.5 0.85 /8
auto jetrate = swoop.LfoRate ramp 0.2 2.5 /8

scene intro 8: cr_intro chords swoops swells rise siren
scene arps 8: cr_beat fm_kicks walk chords nes_arp glide_arp swells swooshes rise
scene theme 8: cr_beat fm_kicks fm_toms pi walk chords nes_arp sid_arp theme under swooshes
scene dub 8: cr_dub walk chords glide_arp pi_dub siren swoops jetrate feed rise
scene theme_b 8: cr_beat fm_kicks fm_toms pi pump chords_b nes_arp_b sid_arp_b glide_arp_b theme_b under_b swells swooshes
scene climax 8: cr_peak fm_kicks fm_toms pump chords_b nes_arp_b sid_walk glide_arp_b theme_b under_b pi_peak swoops swooshes rise
scene outro 8: cr_intro pi chords nes_arp theme under siren swoops swooshes
arrange intro arps theme dub theme_b climax outro
