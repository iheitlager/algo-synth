# Chicago Loop: stabbing Chicago deep house in G minor. A Juno-106 chord
# stabs x.x.. in fives across the barlines, five against the four of the
# kick, so the stab falls differently every bar and only lines up with the
# bar again every fifth. Its filter opens over ten bars and closes over the
# next ten. A 909 groove, an 808 shaker and rimshots, an SH-101 on the
# off-beats.
tempo 121
swing 54
scale g minor

# The Juno's poly patch cut short: a stab.
setting stab = Juno106 JunoPoly: AdsrAttack 0.002, AdsrDecay 0.16, AdsrSustain 0, AdsrRelease 0.12, Cutoff 2200, Resonance 0.3, EnvCutoff 0.5, FenvDecay 0.12

track kit drums Tr909 Kit909
track perc drums Tr808 Kit808
track bass synth Sh101 Sh101Bass
track stab synth stab

strip kit: Level 1
strip perc: Level 0.45, Pan -0.15, Send2 0.15
strip bass: Level 0.6
strip stab: Level 0.6, Pan 0.1, Send1 0.25, Send2 0.2
master: MasterGain 0.8, P1Return 0.35, P1A 0.55, P1B 0.45, P1D 1, P2Return 0.3, P2A 0.8

clip beat = kit /16
  bd x...x...x...x...
  cp ....x.......x...
clip hats = kit /16
  ch xx.xxx.xxx.xxx.X
  oh ..x...x...x...x.
clip shaker = perc /16
  ma x.xxx.xxx.xxx.xX
  rs ......x..x......
# The root on the off-beats, the octave popping at the end of the bar.
clip low = bass
  "~ g1 ~ g1 ~ g1 ~ g2"

# x.x.. in fives, written out over the five bars it takes to come round.
clip stabs = stab
  "<[g3:m7 ~ g3:m7 ~ ~ g3:m7 ~ g3:m7 ~ ~ g3:m7 ~ g3:m7 ~ ~ g3:m7] [~ g3:m7 ~ ~ g3:m7 ~ g3:m7 ~ ~ g3:m7 ~ g3:m7 ~ ~ g3:m7 ~] [g3:m7 ~ ~ g3:m7 ~ g3:m7 ~ ~ g3:m7 ~ g3:m7 ~ ~ g3:m7 ~ g3:m7] [~ ~ g3:m7 ~ g3:m7 ~ ~ g3:m7 ~ g3:m7 ~ ~ g3:m7 ~ g3:m7 ~] [~ g3:m7 ~ g3:m7 ~ ~ g3:m7 ~ g3:m7 ~ ~ g3:m7 ~ g3:m7 ~ ~]>"

# The stab's filter: up and back over twenty bars.
auto sweep = stab.Cutoff 1000 1250 1550 1900 2300 2750 3250 3800 4400 5000 5000 4400 3800 3250 2750 2300 1900 1550 1250 1000 /20
auto bass_low = bass.Cutoff 700 /8

scene drums 4: beat hats shaker
scene bass 4: beat hats shaker low bass_low
scene stab 10: beat hats shaker low stabs bass_low
scene groove 20: beat hats shaker low stabs sweep bass_low
arrange drums bass stab groove
loop 19 38
