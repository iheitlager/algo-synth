tempo 96
swing 50
track kit drums Tr808 TightKit

# The click under every rudiment: kick on one, a hat on each beat,
# and a son clave (3-2) on the claves.
clip click = kit /16
  bd x...............
  ch x...x...x...x...
  cl x..x..x...x.x...

# --- Rolls (o is the soft second stroke of a diddle) ---
# Single stroke roll, sixteenths: R L R L
clip single16 = kit /16
  sn XxxxXxxxXxxxXxxx

# Single stroke roll, thirty-seconds
clip single32 = kit /32
  sn XxxxxxxxXxxxxxxxXxxxxxxxXxxxxxxx

# Double stroke roll: RR LL, each double a stroke and its rebound
clip double = kit /32
  sn XoxoxoxoXoxoxoxoXoxoxoxoXoxoxoxo

# Triple stroke roll, in triplets: RRR LLL
clip triple = kit /24
  sn XooxooXooxooXooxooXooxoo

# Five stroke roll: RR LL R
clip five = kit /32
  sn xoxoX...xoxoX...xoxoX...xoxoX...

# Six stroke roll: R LL RR L
clip six = kit /32
  sn X.xoxoX.X.xoxoX.X.xoxoX.X.xoxoX.

# Seven stroke roll: RR LL RR L
clip seven = kit /32
  sn xoxoxoX.xoxoxoX.xoxoxoX.xoxoxoX.

# Nine stroke roll: RR LL RR LL R
clip nine = kit /32
  sn xoxoxoxoX.......xoxoxoxoX.......

# Single stroke four, triplets: R L R L(accent)
clip stroke4 = kit /24
  sn xxxX..xxxX..xxxX..xxxX..

# Single stroke seven, triplets
clip stroke7 = kit /24
  sn xxxxxxX.xxxxxxX.xxxxxxX.

# Crescendo roll: ghosts, hits, then accents
clip crescendo = kit /32
  sn o.o.o.o.x.x.x.x.xxxxxxxxXXXXXXXX

# --- Diddles ---
# Single paradiddle: R L RR  L R LL
clip paradiddle = kit /16
  sn XxxoXxxoXxxoXxxo

# Double paradiddle, triplets: R L R L RR
clip dblpara = kit /24
  sn XxxxxoXxxxxoXxxxxoXxxxxo

# Paradiddle-diddle, triplets: R L RR LL
clip paradiddle_diddle = kit /24
  sn XxxoxoXxxoxoXxxoxoXxxoxo

# Triple paradiddle: R L R L R L RR
clip triplepara = kit /16
  sn XxxxxxxoXxxxxxxo

# --- Flams (f: a soft grace just before the stroke) ---
# Flam on every beat
clip flam = kit /16
  sn f...f...f...f...

# Flam tap: flam and a tap from the same hand
clip flamtap = kit /16
  sn fxfxfxfxfxfxfxfx

# Flam accent, triplets: flam tap tap
clip flamaccent = kit /24
  sn fxxfxxfxxfxxfxxfxxfxxfxx

# Flamacue: flam, accent, tap, tap, flam
clip flamacue = kit /16
  sn fXxxf...fXxxf...

# Flam paradiddle
clip flampara = kit /16
  sn fxxofxxofxxofxxo

# Pataflafla: flam tap tap flam
clip pataflafla = kit /16
  sn fxxffxxffxxffxxf

# Swiss army triplet: flam, rebound, tap
clip swiss = kit /24
  sn foxfoxfoxfoxfoxfoxfoxfox

# Flam drag: flam, drag, tap
clip flamdrag = kit /24
  sn f.dx..f.dx..f.dx..f.dx..

# --- Drags (d: two soft graces before the stroke) ---
# Drag on every beat
clip drag = kit /16
  sn d...d...d...d...

# Single drag tap: drag, accent
clip dragtap = kit /16
  sn d.X.d.X.d.X.d.X.

# Lesson 25: drag, tap, accent
clip lesson25 = kit /16
  sn dxX.dxX.dxX.dxX.

# Single ratamacue: drag, tap, tap, accent
clip ratamacue = kit /16
  sn dxxXdxxXdxxXdxxX

# Drag paradiddle: accent, drag paradiddle
clip dragpara = kit /16
  sn XdxoXdxoXdxoXdxo

# --- In a groove: ghost notes between backbeats ---
clip ghosts = kit /16
  sn .oo.Xo.o.oo.X.oo
  bd x.....x...x.....
  ch x.x.x.x.x.x.x.x.

scene single16 2: click single16
scene single32 2: click single32
scene double 2: click double
scene triple 2: click triple
scene five 2: click five
scene six 2: click six
scene seven 2: click seven
scene nine 2: click nine
scene stroke4 2: click stroke4
scene stroke7 2: click stroke7
scene crescendo 2: click crescendo
scene paradiddle 2: click paradiddle
scene dblpara 2: click dblpara
scene paradiddle_diddle 2: click paradiddle_diddle
scene triplepara 2: click triplepara
scene flam 2: click flam
scene flamtap 2: click flamtap
scene flamaccent 2: click flamaccent
scene flamacue 2: click flamacue
scene flampara 2: click flampara
scene pataflafla 2: click pataflafla
scene swiss 2: click swiss
scene flamdrag 2: click flamdrag
scene drag 2: click drag
scene dragtap 2: click dragtap
scene lesson25 2: click lesson25
scene ratamacue 2: click ratamacue
scene dragpara 2: click dragpara
scene ghosts 2: ghosts
arrange single16 single32 double triple five six seven nine stroke4 stroke7 crescendo paradiddle dblpara paradiddle_diddle triplepara flam flamtap flamaccent flamacue flampara pataflafla swiss flamdrag drag dragtap lesson25 ratamacue dragpara ghosts
