# Patch Bay: peak-time techno in G minor. A 909 does the drums; every other
# voice but the acid line is a SuperCollider SynthDef on the Modular synth.
# A rolling sub, an ms20-filtered dub stab into the echo, an FM ping, a
# Splay pad, a noise zap and a rave hoover for the drop.
tempo 132
swing 53
scale g minor

# A sine and a saw through the Minimoog's ladder, short and driven.
setting rumble = Modular ModularBasic
  SynthDef(\rumble, { |freq = 55, cutoff = 260, gate = 1|
      var sig = SinOsc.ar(freq) + (Saw.ar(freq * 1.005) * 0.4);
      sig = MoogFF.ar(sig, cutoff, 2.2, voicing: \minimoog, drive: 0.5);
      (sig * 2).tanh * EnvGen.kr(Env.perc(0.004, 0.26), gate) * 0.7
  }).add;

# Two detuned saws and a sub pulse through the MS-20's filter, the envelope
# opening it; slowly panned.
setting stab = Modular ModularBasic
  SynthDef(\stab, { |freq = 440, cutoff = 1500, gate = 1|
      var env = EnvGen.kr(Env.perc(0.002, 0.32), gate);
      var sig = Saw.ar(freq * 0.997) + Saw.ar(freq * 1.003) + Pulse.ar(freq * 0.5, 0.3);
      sig = RLPF.ar(sig, cutoff * (env + 0.3), 0.35, voicing: \ms20);
      Pan2.ar(sig * env * 1.2, SinOsc.kr(0.2) * 0.5)
  }).add;

# A phase-modulated bell whose index falls with its envelope, panned at random.
setting ping = Modular ModularBasic
  SynthDef(\ping, { |freq = 440, index = 3, gate = 1|
      var env = EnvGen.kr(Env.perc(0.001, 0.4), gate);
      var sig = PMOsc.ar(freq, freq * 1.41, index * env);
      Pan2.ar(sig * env * 0.7, Rand(-0.6, 0.6))
  }).add;

# Four drifting saws spread wide, a slow sweep through the CS-15's filter.
setting haze = Modular ModularBasic
  SynthDef(\haze, { |freq = 220, gate = 1|
      var sig = { Saw.ar(freq * Rand(0.99, 1.01)) }.dup(4);
      sig = RLPF.ar(Splay.ar(sig), SinOsc.kr(0.07).exprange(300, 2400), 0.5, voicing: \cs15);
      sig * EnvGen.kr(Env.asr(1.2, 1, 2.5), gate) * 0.35
  }).add;

# Filtered noise and a falling blip.
setting zap = Modular ModularBasic
  SynthDef(\zap, { |freq = 440, gate = 1|
      var env = EnvGen.kr(Env.perc(0.001, 0.18), gate);
      var blip = SinOsc.ar(Env.perc(0.001, 0.06).kr.exprange(150, 2500));
      var sig = RHPF.ar(WhiteNoise.ar, freq * 4, 0.2) + blip;
      Pan2.ar(sig * env * 0.6, Rand(-0.8, 0.8))
  }).add;

# The hoover of #216, lighter: six detuned saw-and-pulse pairs that dive in.
setting hoov = Modular ModularBasic
  SynthDef(\hoov, { |freq = 440, gate = 1|
      var snd, f;
      f = freq * Env([-4, 2, 0], [0.08, 0.6], [\lin, -4]).kr.midiratio;
      snd = { Saw.ar(f * ExpRand(1.02, 0.98)) + Pulse.ar(f * 0.5 * ExpRand(1.02, 0.98), 0.3) }.dup(6);
      snd = (Splay.ar(snd) * 1.5).atan;
      RLPF.ar(snd, 3200, 0.6) * EnvGen.kr(Env.adsr(0.02, 0.3, 0.7, 0.5), gate) * 0.5
  }).add;

track kit drums Tr909 Kit909
track sub synth rumble
track acid synth Sh101 AcidBass
track stab synth stab
track ping synth ping
track pad synth haze
track zap synth zap
track hoover synth hoov

strip kit: Level 1
strip sub: Level 0.65
strip acid: Level 0.22, Pan -0.15, I1Type Overdrive, I1A 0.3, Send1 0.15
strip stab: Level 0.7, Send1 0.45, Send2 0.2
strip ping: Level 0.4, Pan 0.2, Send1 0.35
strip pad: Level 0.45, Send2 0.5
strip zap: Level 0.3, Send1 0.3
strip hoover: Level 0.45, Send2 0.3
master: MasterGain 0.8, P1Return 0.3, P1B 0.5, P2Return 0.3

clip kick = kit /16
  bd x...x...x...x...
clip tick = kit /16
  ch x.x.x.x.x.x.x.x.
clip hats = kit /16
  ch xxXx xxXx xxXx xxXX
  oh ..x...x...x...x.
clip clap = kit /16
  cp ....x.......x...
  rs euclid(5,16,3)
clip ride = kit /16
  rd x.x.x.x.x.x.x.x.
clip toms = kit /16
  lt euclid(3,16,2)
  ht euclid(5,16,7)
clip roll = kit /16
  sn x.x.x.x.xxxxXXXX
clip crash = kit /16
  cr x...............................................................

clip rolling = sub
  "[~ g1! g1 g1] [~ g1! g1 g1] [~ g1! g1 g1] [~ <g1 f1 bb1 c2> g1 g1]"
clip pulse = sub
  "~ g1 ~ g1 ~ g1 ~ g1"

clip line = acid
  "g2 g2& bb2 g3 ~ g2 f2& g2 ~ g2 c3& d3 g2 ~ bb2 g2"
clip line_b = acid .every(4, rev)
  mutate(line,30,4)

clip chord = stab
  "~ ~ [g3!,bb3!,d4!] ~ ~ ~ ~ [g3,bb3,d4] ~ ~ [g3,bb3,d4] ~ ~ ~ ~ ~"
clip chord_dub = stab .send1(0.7)
  "~ ~ <[g3,bb3,d4] [eb3,g3,bb3]> ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"

clip bells = ping
  euclid(5,16,2) scale g4
clip sparks = ping live
  arp([g4,bb4,d5,f5,g5],random,16,9)

clip wash = pad .slow(2)
  "<[g2,d3,bb3] [eb2,bb2,g3] [c3,g3,eb4] [d3,a3,f4]>"

clip zaps = zap
  euclid(3,8,1) c5

clip theme = hoover
  g3:2. bb3:8 a3:8 g3:2 f3:4 d3:4

auto acid_shut = acid.Cutoff 350 /8
auto acid_open = acid.Cutoff ramp 400 2600 /16
auto acid_scream = acid.Cutoff 1800 3200 2400 3600 /4
auto acid_soft = acid.Resonance 0.4 /8
auto acid_build = acid.Resonance ramp 0.4 0.85 /4
auto acid_peak = acid.Resonance 0.75 /4
auto riser = zap.Level ramp 0 0.5 /4
auto echo_up = master.P1Return ramp 0.3 0.6 /4

snapshot dry: master.P1Return 0.3, master.P2Return 0.3
snapshot wet: master.P1Return 0.55, master.P2Return 0.5

scene intro 8: kick tick wash [dry]
scene groove 16: kick hats clap pulse bells
scene acid 16: kick hats clap rolling line acid_open acid_soft
scene breakdown 8: wash chord_dub sparks [wet]
scene build 4: roll chord line_b zaps acid_shut acid_build riser echo_up
scene drop 16: crash kick hats clap ride rolling line chord theme acid_scream acid_peak [dry]
scene peak 16: crash kick hats clap ride toms rolling line_b chord sparks zaps acid_scream acid_peak
scene outro 8: kick tick pulse wash acid_shut acid_soft
arrange intro groove acid breakdown build drop peak outro
loop 53 84
